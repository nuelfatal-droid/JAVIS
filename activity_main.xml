<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#06101D">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NAFTAL LABS  /  AI SYSTEMS" android:textColor="#56DCFF" android:textStyle="bold" android:letterSpacing="0.16" android:textSize="12sp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="J.A.R.V.I.S" android:textColor="#EAF9FF" android:textSize="32sp" android:gravity="center" android:paddingTop="38dp" android:textStyle="bold" android:letterSpacing="0.12" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SYSTEM STANDBY" android:textColor="#56DCFF" android:gravity="center" android:padding="12dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wake word: BUMBLEBEE (starter)\nCreate a custom ‘Hey Jarvis’ model in Picovoice Console to replace it." android:textColor="#A7C1D2" android:gravity="center" android:padding="12dp" />
  <EditText android:id="@+id/pvKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Picovoice AccessKey" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#7793A6" android:backgroundTint="#28718B" />
  <EditText android:id="@+id/groqKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Groq API key" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#7793A6" android:backgroundTint="#28718B" />
  <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE KEYS ON THIS DEVICE" />
  <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="START WAKE-WORD LISTENING" />
  <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STOP LISTENING" />
  <Button android:id="@+id/talk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TALK TO JARVIS" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOICE COMMANDS\n• ‘Open WhatsApp / YouTube / Maps / Chrome / Settings’\n• ‘Set an alarm for 6:30 AM’\n• ‘Remind me to call the supplier’\n• ‘WhatsApp I will call you back’\n\nJARVIS prepares WhatsApp messages but never sends them without your tap. Alarm and reminder details are confirmed in your phone apps." android:textColor="#A7C1D2" android:padding="12dp" android:textSize="13sp" />
  <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conversation will appear here." android:textColor="#EAF9FF" android:padding="14dp" android:minHeight="110dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Privacy: wake-word detection runs on-device. After activation, Android speech recognition and Groq process your spoken request. A persistent Android notification appears while listening. Stop listening at any time." android:textColor="#8EA7BA" android:textSize="12sp" android:paddingTop="12dp" />
 </LinearLayout>
</ScrollView>
